[Unit]
Description=Telemedicine FastAPI Demo Service (SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telemedicine
Group=telemedicine
WorkingDirectory=/opt/telemedicine
EnvironmentFile=/etc/telemedicine.env
ExecStart=/opt/telemedicine/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8003 --workers 1
Restart=on-failure
RestartSec=5
MemoryMax=400M
NoNewPrivileges=true
PrivateTmp=false
ReadWritePaths=/var/lib/telemedicine

[Install]
WantedBy=multi-user.target
